$processName = "PolicyAgent" 

while($true) {
    Clear-Host
    $proc = Get-Process -Name $processName -ErrorAction SilentlyContinue
    
    if ($proc) {
        $privateBytes = ($proc.PrivateMemorySize64 | Measure-Object -Sum).Sum
        $privateMB = [math]::Round($privateBytes / 1MB, 2)
        
        # Calculate Working Set (Total Physical RAM used)
        $workingBytes = ($proc.WorkingSet | Measure-Object -Sum).Sum
        $workingMB = [math]::Round($workingBytes / 1MB, 2)
        $Confidence = 0
	$TestMB = 25

        if ($workingMB -ge 32) {
            Write-Host "The system is running." -ForegroundColor Red
          		 $BoundedMB = [Math]::Max(20, [Math]::Min(40, $WorkingMB))
		$Confidence = ($BoundedMB - 20) * 5
		
	elseif ($workingMB -gt 27 -and $workingMB -lt 32) {
		Write-Host "The system is sleeping." -ForegroundColor Gray
		Write-Host "It is active on the host computer, but is conserving memory usage by not taking thumbnails of your computer." -ForegroundColor Gray
		$Confidence = :Round((32 - $workingMB) / 5 * 100, 0)
}         
        }
        
        if ($workingMB -le 27) {
            Write-Host "The system is not running." -ForegroundColor Green
			$BoundedMB = [Math]::Max(20, [Math]::Min(40, $WorkingMB))

		# Calculate Confidence percentage (100% at 20MB, 0% at 40MB)
		$Confidence = (40 - $BoundedMB) * 5
                    }
        
        Write-Host "Confidence: $Confidence%" -ForegroundColor Yellow
        Write-Host "----------------------------------"
        Write-Host "Private: $privateMB MB" -ForegroundColor White
        Write-Host "Total Physical (WS): $workingMB MB" -ForegroundColor White
        Write-Host "----------------------------------"
        Write-Host "Press Ctrl+C to immediately close the window." -ForegroundColor DarkGray

    } else {
        Write-Host "Searching for $processName..." -ForegroundColor Red
    }
    
    Start-Sleep -Seconds 1
}
catch {
    Clear-Host
    Write-Host "==================================================" -ForegroundColor Red
    Write-Host " SCRIPT LAUNCH FAILED DURING INITIALISATION " -ForegroundColor Red
    Write-Host "==================================================" -ForegroundColor Red
    Write-Host "Error Type Details:" -ForegroundColor Yellow
    Write-Host $_.Exception.Message -ForegroundColor White
    Write-Host "`nStack Location Trace:" -ForegroundColor Yellow
    Write-Host $_.ScriptStackTrace -ForegroundColor Gray
    Write-Host "==================================================" -ForegroundColor Red
    Write-Host "`nThe script has paused to let you read this error." -ForegroundColor Cyan

}

